# Copy to .env and fill in. Never commit the filled version.

# Telegram Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat ID of the group the bot should listen to.
# To find it: add @userinfobot to the group, or enable debug logging and
# send any message to the group once the bot joins.
# Note: group chat IDs are typically negative integers (e.g. -1001234567890).
TELEGRAM_GROUP_CHAT_ID=

# Anthropic API key — used for badge OCR + structured lead extraction.
ANTHROPIC_API_KEY=

# OpenAI API key — used for Whisper voice transcription only.
OPENAI_API_KEY=

# Tagged on every lead; appears in the CSV Event column.
EVENT_NAME=KubeCon EU 2026

# Optional overrides.
# PAIRING_WINDOW_SECONDS=180
# DATA_DIR=./data
# ANTHROPIC_MODEL=claude-opus-4-6
